t":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/77742560@N06\">shankar s.</a> from Dubai, united arab emirates","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"67775806":{"pageid":67775806,"ns":6,"title":"File:Wild pepper plant- no peppers though (28760919705).jpg","index":11,"imagerepository":"local","imageinfo":[{"size":3196120,"width":4288,"height":2848,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg/1920px-Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1063,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg/3840px-Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg/1920px-Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1063,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg/3840px-Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/2/28/Wild_pepper_plant-_no_peppers_though_%2828760919705%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Wild_pepper_plant-_no_peppers_though_(28760919705).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/67775806","extmetadata":{"ImageDescription":{"value":"A wild black pepper plant growing on one of the trees in the tea garden. This is also a pepper growing area though the pepper plantations are different. You had glimpses of them in my Vagamon album. Although it was fascinating to see the pepper plant, it was not season so we did not find any of the pepper growing on the plant. Incidentally, when I say pepper, I am referring to the black pepper of the peppercorn variety, not the hot peppers of the chilly variety.  (Vagamon/ Munnar Tea Estates, Kerala, India, Apr. 2016)","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/77742560@N06\">shankar s.</a> from Dubai, united arab emirates","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]}}}}