mbnail_unscaled","thumbwidth":1600,"thumbheight":979,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/5/5c/Harvesting_of_Pepper_in_Coilum_in_southern_India-14TH_CENTURY_Painting.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":979},"url":"https://upload.wikimedia.org/wikipedia/commons/5/5c/Harvesting_of_Pepper_in_Coilum_in_southern_India-14TH_CENTURY_Painting.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Harvesting_of_Pepper_in_Coilum_in_southern_India-14TH_CENTURY_Painting.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/16462378","extmetadata":{"Artist":{"value":"<div class=\"fn value\">\nMazarine Master</div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\nPepper, shown here being harvested in Coilum in southern India, was one of the most profitable trade items shipped to Europe. However, the romance of the spice trade makes it easy to forget that the bulk of Indian Ocean shipping was devoted to cargoes like rice, hardwoods, tin, iron ore, horses, rope, textiles and other daily essentials. BIBLIOTHEQUE NATIONALE / ARCHIVES CHARMET / BRIDGEMAN ART LIBRARY (BOUCICAUT MASTER)</div>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"23468027":{"pageid":23468027,"ns":6,"title":"File:India - Kerala - 062 - spice plantation - pepper (2077696203).jpg","index":1,"imagerepository":"local","imageinfo":[{"size":1285065,"width":1944,"height":2592,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/India_-_Kerala_-_062_-_spice_plantation_-_pepper_%282077696203%29.jpg/1920px-India_-_Kerala_-_062_-_spice_plantation_-_pepper_%282077696203%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2133,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/7/74/India_-_Kerala_-_062_-_spice_plantation_-_pepper_%282077696203%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/India_-_Kerala_-_062_-_spice_plantation_-_pepper_%282077696203%29.jpg/1920px-India_-_Kerala_-_062_-_spice_plantation_-_pepper_%282077696203%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2133,"srcset":"https://upload.wikimedia.org/wikipedia/commons/7/74/India_-_Kerala_-_062_-_spice_plantation_-_pepper_%282077696203%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/74/India_-_Kerala_-_062_-_spice_plantation_-_pepper_%282077696203%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:India_-_Kerala_-_062_-_spice_plantation_-_pepper_(2077696203).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/23468027","extmetadata":{"ImageDescription":{"value":"<p>Pepper growing in a spice plantation in Kerala. \n</p>\nPepper is a vine and therefore can be planted in double-duty around other fruit or spice trees. We saw them in several spots in the area - in the wild in Periyar, in spice plantations and as an extra crop wrapped around the shade trees in the tea plantations. Tasty!","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/56796376@N00\">McKay Savage</a> from London, UK","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""}},"mime":"image