1600},"url":"https://upload.wikimedia.org/wikipedia/commons/4/49/Cardamom.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Cardamom.JPG","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/8548169","extmetadata":{"ImageDescription":{"value":"Bowl of green cardamom pods for use in cooking","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Jonathunder\" title=\"User:Jonathunder\">Jonathunder</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"33881501":{"pageid":33881501,"ns":6,"title":"File:Cardamom (5193854049).jpg","index":6,"imagerepository":"local","imageinfo":[{"size":330852,"width":1000,"height":1000,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Cardamom_%285193854049%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1600,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Cardamom_%285193854049%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1600},"url":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Cardamom_%285193854049%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Cardamom_(5193854049).jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/33881501","extmetadata":{"ImageDescription":{"value":"The store carries both black and green cardamom (elaichi). The green is the flavor most non-Indian-cooking folks are more familiar with, and is used in both savory and sweet (like Chai) preparations.  You generally use the seeds inside the outer pod, but they lose their flavor quickly so best to keep stored in pod until ready for use.  When using, toast the entire pod in a dry pan, then you can crack the pod to release the seeds for grinding.  Karuna noted she's not a fan of the black cardamom. It's generally used in savory preparations only and has a hot, astringent, peppery quality.  In addition to its culinary flavoring purposes, cardamom is thought to be helpful with digestion.","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/38559542@N02\">Leslie Seaton</a> from Seattle, WA, USA","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"32278993":{"pageid":32278993,"ns":6,"title":"File:Cardamom (Elettaria cardamomum).jpg","index":4,"imagerepository":"local","imageinfo":[{"size":2945264,"width":3920,"height":2204,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/Cardamom_%28Elettaria_cardamomum%29.jpg/1920px-Cardamom_%28Elettaria_cardamomum%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":900,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/Cardamom_%28Elettaria_cardamomum%29.jpg/3840px-Cardamom_%28Elettaria_cardamomum%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/Cardamom_%28Elettaria_cardamomum%29.jpg/1920px-Cardamom_%28Elettaria_cardamomum%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":900,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/Cardamom_%28Elettaria_cardamomum%29.jpg/3840px-Cardamom_%28Elettaria_cardamomum%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https: