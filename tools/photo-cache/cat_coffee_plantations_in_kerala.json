media.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1d/Coffea_arabica-_fruit11.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Coffea_arabica-_fruit11.JPG","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/27705264","extmetadata":{"ImageDescription":{"value":"coffee fruit at Wynad, Kerala, India","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Satheesan.vn\" title=\"User:Satheesan.vn\">Satheesan.vn</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"11607214":{"pageid":11607214,"ns":6,"title":"File:Coffea.jpg","imagerepository":"local","imageinfo":[{"size":2760954,"width":3072,"height":2304,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Coffea.jpg/1920px-Coffea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1200,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/c/cc/Coffea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Coffea.jpg/1920px-Coffea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1200,"srcset":"https://upload.wikimedia.org/wikipedia/commons/c/cc/Coffea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/cc/Coffea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Coffea.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/11607214","extmetadata":{"Artist":{"value":"<div class=\"fn value\">\n<a href=\"//commons.wikimedia.org/wiki/User:Jkadavoor\" title=\"User:Jkadavoor\">Jeevan Jose, Kerala, India</a></div>","source":"commons-desc-page"},"ImageDescription":{"value":"Robusta coffee (<i><a href=\"https://en.wikipedia.org/wiki/Coffea_canephora\" class=\"extiw\" title=\"w:Coffea canephora\">Coffea canephora</a></i>; syn. <i>Coffea robusta</i>) is a species of <a href=\"https://en.wikipedia.org/wiki/coffee\" class=\"extiw\" title=\"w:coffee\">coffee</a> that has its origins in central and western sub-Saharan <a href=\"https://en.wikipedia.org/wiki/Africa\" class=\"extiw\" title=\"w:Africa\">Africa</a>. It is a species of flowering plant in the <a href=\"https://en.wikipedia.org/wiki/Rubiaceae\" class=\"extiw\" title=\"w:Rubiaceae\">Rubiaceae</a> family. Though widely known as Coffea robusta, the plant is scientifically identified as <i>Coffea canephora</i>, which has two main varieties - Robusta and Nganda.\n<p>The plant has a shallow root system and grows as a robust tree or shrub to about 10 metres. It flowers irregularly, taking about 10\u201311 months for cherries to ripen, producing oval-shaped beans. The robusta plant has a greater crop yield than that of <i><a href=\"https://en.wikipedia.org/wiki/Coffea_arabica\" class=\"extiw\" title=\"w:Coffea arabica\">Coffea arabica</a></i>, and contains more <a href=\"https://en.wikipedia.org/wiki/caffeine\" class=\"extiw\" title=\"w:caffeine\">caffeine</a> - 2.7% compared to arabica's 1.5%. As it is less susceptible to pests and disease, robusta needs much less herbicide and pesticide than arabica.\n</p>\nOriginating in upland forests in <a href=\"https://en.wikipedia.org/wiki/Ethiopia\" class=\"extiw\" title=\"w:Ethiopia\">Ethiopia</a>, <i>C. canephora</i> grows indigenously in Western and Central <a href=\"https://en.wikipedia.org/wiki/Africa\" class=\"extiw\" title=\"w:Africa\">Africa</a>. It was not recognized as a species of Coffea until the 19th century, about a hundred years after <i><a href=\"https://en.wikipedia.org/wiki/Coffea_arabica\" class=\"extiw\" title=\"w:Coffea arabica\">Coffea arabica</a></i>.","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"147508458":{"pageid":147508458,"ns":6,"title":"File:Coffee 12.jpg","imagerepository":"local","imageinfo":[{"size":2442033,"width":3060,"height":4080,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Coffee_12.jpg/1920px-Coffee_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2133,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/f/f3/Coffee_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Coffee_12.jpg/1920px-Coffee_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2133,"srcset":"https://upload.wikimedia.org/wikipedia/commons/f/f3/Coffee_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/f3/Coffee_12.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Coffee_12.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/147508458","extmetadata":{"ImageDescription":{"value":"Coffee\u00a0<span class=\"mw-valign-text-top noprint\" typeof=\"mw:File/Frameless\"><a href=\"//commons.wik