{"continue":{"iistart":"2012-03-06T09:58:41Z","continue":"||"},"query":{"pages":{"9811944":{"pageid":9811944,"ns":6,"title":"File:Myristica fragrans by kadavoor.jpg","index":1,"imagerepository":"local","imageinfo":[{"size":1179586,"width":2479,"height":2502,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Myristica_fragrans_by_kadavoor.jpg/1920px-Myristica_fragrans_by_kadavoor.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1615,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/f/fe/Myristica_fragrans_by_kadavoor.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Myristica_fragrans_by_kadavoor.jpg/1920px-Myristica_fragrans_by_kadavoor.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1615,"srcset":"https://upload.wikimedia.org/wikipedia/commons/f/fe/Myristica_fragrans_by_kadavoor.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/fe/Myristica_fragrans_by_kadavoor.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Myristica_fragrans_by_kadavoor.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/9811944","extmetadata":{"ImageDescription":{"value":"Myristica fragrans. <a href=\"https://en.wikipedia.org/wiki/Nutmeg\" class=\"extiw\" title=\"w:Nutmeg\">Nutmeg</a> is a spreading evergreen tree. This unisexual tree is quite unique in that is bears two separate and distinct products; nutmeg which is the kernel of the seed, and Mace which is the dried aril that surrounds the nutmeg within the fruit. Both nutmeg and mace are used in vegetarian and non-vegetarian dishes. It is used in pulaous, biryanis especially Mughlai types. They are also used as an ingredient in biscuits, cookies, fruit salad, puddings, pastries and milk drinks. The oil forms of nutmeg and mace are frequently used in meat seasoning, soft-drinks and pharmaceuticals, especially in cough mixtures. Taken at <a href=\"https://en.wikipedia.org/wiki/Kadavoor\" class=\"extiw\" title=\"w:Kadavoor\">Kadavoor</a>, <a href=\"https://en.wikipedia.org/wiki/Kerala\" class=\"extiw\" title=\"w:Kerala\">Kerala</a>, <a href=\"https://en.wikipedia.org/wiki/India\" class=\"extiw\" title=\"w:India\">India</a>.","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Jkadavoor\" title=\"User:Jkadavoor\">Jeevan Jose, Kerala, India</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]}}}}